{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caraxyn",
  "identifier": "app.caraxyn",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Caraxyn",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "linux": {
      "appimage": {
        "files": {
          "/usr/lib/libayatana-appindicator3.so.1": "/usr/lib/x86_64-linux-gnu/libayatana-appindicator3.so.1",
          "/usr/lib/libayatana-indicator3.so.7": "/usr/lib/x86_64-linux-gnu/libayatana-indicator3.so.7",
          "/usr/lib/libayatana-ido3-0.4.so.0": "/usr/lib/x86_64-linux-gnu/libayatana-ido3-0.4.so.0",
          "/usr/lib/libdbusmenu-glib.so.4": "/usr/lib/x86_64-linux-gnu/libdbusmenu-glib.so.4",
          "/usr/lib/libdbusmenu-gtk3.so.4": "/usr/lib/x86_64-linux-gnu/libdbusmenu-gtk3.so.4"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBRTY4NkNFM0JFNjlFNEUKUldST251WTd6b2JtR3FqbHBxVVR3dkFzaHNkM3RDMkgxb1hsTHlSb2pweHlBQzRSaTB4cnRJV0cK",
      "endpoints": ["https://github.com/CptJay/Caraxyn/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
